# Copy to .env and fill in. Both binaries read .env from the working
# directory; real environment variables take precedence.

# Required — Postgres connection (docker-compose default below)
DATABASE_URL=postgres://osint:osint@localhost:5433/osint

# LLM classification (collector). Empty = fetch-only, no classification.
OPENAI_API_KEY=
# Optional override for OpenAI-compatible gateways
#OPENAI_BASE_URL=https://api.openai.com/v1
#ENRICH_MODEL=gpt-5-mini
#MAX_ENRICH_PER_RUN=300
# Event clustering (uses the same OPENAI_API_KEY, text-embedding-3-small).
# CLUSTER_THRESHOLD is the cosine similarity at which two reports are treated
# as one event. Higher = merges less. Measured against real embeddings rather
# than guessed; re-run internal/cluster's calibration test before changing it.
#MAX_CLUSTER_PER_RUN=1000
#CLUSTER_THRESHOLD=0.70

# Signal layers — each is skipped when its key is empty.
# NASA FIRMS thermal anomalies: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# OpenSky OAuth2 client (optional; anonymous fallback with tight rate limits)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# How often the server polls Finnish Digitraffic to archive AIS positions in
# the cable corridors. No key needed (CC BY 4.0). aisstream is realtime-only,
# so this is what gives us track history at all.
#AIS_ARCHIVE_MINUTES=15
# aisstream.io sea-activity watch (runs in the server): https://aisstream.io
AISSTREAM_API_KEY=
# Sentinel-1 SAR change detection over monitored sites.
#   1. Register (free): https://dataspace.copernicus.eu
#   2. User Settings -> OAuth clients -> create a client
#   3. Paste the client id/secret here. Runs at most once per day.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ACLED is deliberately NOT ingested. Their EULA requires external use to be
# "transformative" and states it is "not sufficient for Licensed Content to
# simply be ... made available through Licensee's own dashboard", and their
# content terms bar building "a functional substitute" for their platforms.
# Link to ACLED; do not fetch it.

# Server
#LISTEN_ADDR=:8080
#STATIC_DIR=web/dist
